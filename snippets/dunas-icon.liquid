{% doc %}
  DUNAS line icons: one 1.5px stroke weight on a 24px grid, drawn in currentColor so they take
  the colour of the text around them.

  @param {string} name - leaf, drop, sun, hand, shield, sparkle, dune, heart.

  @example
  {% render 'dunas-icon', name: 'leaf' %}
{% enddoc %}
<svg
  class="dunas-icon dunas-icon--{{ name }}"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/>
      <path d="M5 19c3-4 6-7 10-9"/>
    {%- when 'drop' -%}
      <path d="M12 3.5c3.5 4.2 6 7.6 6 10.5a6 6 0 0 1-12 0c0-2.9 2.5-6.3 6-10.5Z"/>
      <path d="M9.5 14.5a2.6 2.6 0 0 0 2.5 2.5"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
    {%- when 'hand' -%}
      <path d="M7 12V6.5a1.5 1.5 0 0 1 3 0V11"/>
      <path d="M10 10.5V5a1.5 1.5 0 0 1 3 0v5.5"/>
      <path d="M13 10.5V6.5a1.5 1.5 0 0 1 3 0V13"/>
      <path d="M16 9.5a1.5 1.5 0 0 1 3 0V14a7 7 0 0 1-7 7h-.6a6 6 0 0 1-4.6-2.2L4 14.6a1.6 1.6 0 0 1 2.4-2.1L8 14"/>
    {%- when 'shield' -%}
      <path d="M12 3 5 6v5.5c0 4.5 3 8 7 9.5 4-1.5 7-5 7-9.5V6l-7-3Z"/>
      <path d="m9 12 2 2 4-4"/>
    {%- when 'sparkle' -%}
      <path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7Z"/>
      <path d="M18.5 16c.2 1.5.8 2.1 2.3 2.3-1.5.2-2.1.8-2.3 2.3-.2-1.5-.8-2.1-2.3-2.3 1.5-.2 2.1-.8 2.3-2.3Z"/>
    {%- when 'dune' -%}
      <path d="M2.5 17.5c3-4.5 6-6.5 9.5-6.5s6.5 2 9.5 6.5"/>
      <path d="M6.5 17.5c1.6-2 3.4-3 5.5-3s3.9 1 5.5 3"/>
      <circle cx="17" cy="6" r="2"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.4-7.5-10A4.2 4.2 0 0 1 12 7.6 4.2 4.2 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10Z"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
