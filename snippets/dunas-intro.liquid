      {%- if settings.dunas_intro_tagline != blank -%}
        <p class="dunas-intro__tagline">{{ settings.dunas_intro_tagline | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function () {
      var intro = document.getElementById('DunasIntro');
      if (!intro) return;

      // Already seen this visit (decided in <head> before the page painted): remove quietly
      if (document.documentElement.classList.contains('dunas-skip-intro')) {
        intro.parentNode.removeChild(intro);
        return;
      }

      try {
        if (intro.dataset.mode === 'once_per_visit') sessionStorage.setItem('dunasIntroSeen', '1');
        if (intro.dataset.mode === 'first_visit') localStorage.setItem('dunasIntroSeenAt', String(Date.now()));
      } catch (e) {}

      var finished = false;
      var skipEvents = ['pointerdown', 'wheel', 'touchmove', 'keydown'];

      function finish() {
        if (finished) return;
        finished = true;
        skipEvents.forEach(function (name) {
          window.removeEventListener(name, skip, true);
        });
        if (intro.parentNode) intro.parentNode.removeChild(intro);
        document.documentElement.classList.add('dunas-intro-done');
        window.dispatchEvent(new Event('dunas:intro-done'));
      }

      // Any tap, click, scroll, swipe or key press ends the intro right away
      function skip() {
        if (intro.classList.contains('is-skipping')) return;
        intro.classList.add('is-skipping');
        setTimeout(finish, 600);
      }

      skipEvents.forEach(function (name) {
        window.addEventListener(name, skip, { capture: true, passive: true });
      });

      intro.addEventListener('animationend', function (event) {
        if (event.target !== intro) return;
        if (/^dunas-intro-(lift|skip|fade)$/.test(event.animationName)) finish();
      });

      // Safety net in case animations are blocked
      setTimeout(finish, 6000);
    })();
  </script>
{%- endif -%}
