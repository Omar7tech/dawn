{% doc %}
  Brand intro in pure CSS (no libraries): the DUNAS wordmark traces itself in a fine line,
  fills in, the tagline fades up, then the panel lifts away.
  All options live in Theme settings > DUNAS intro. Any tap, click, scroll, swipe or key
  press skips straight to the exit. Never shown inside the theme editor.

  @example
  {% render 'dunas-intro' %}
{% enddoc %}
{%- liquid
  assign intro_mode = settings.dunas_intro | default: 'home_page'
  assign show_intro = true

  if request.design_mode or intro_mode == 'off'
    assign show_intro = false
  endif

  if intro_mode == 'home_page' and request.page_type != 'index'
    assign show_intro = false
  endif

  case settings.dunas_intro_speed
    when 'quick'
      assign intro_speed = 0.65
    when 'relaxed'
      assign intro_speed = 1.3
    else
      assign intro_speed = 1
  endcase

  assign intro_bg = settings.dunas_intro_bg | default: '#556361'
  assign intro_ink = settings.dunas_intro_ink | default: '#F1EFE7'
  assign intro_logo_width = settings.dunas_intro_logo_width | default: 340
-%}
{%- if show_intro -%}
  <style>
    .dunas-intro {
      /* Timeline (seconds at balanced speed; every value scales with --s) */
      --s: {{ intro_speed }};
      --t-draw: calc(0.05s * var(--s));
      --t-fill: calc(0.65s * var(--s));
      --t-tagline: calc(0.85s * var(--s));
      --t-exit: calc(1.6s * var(--s));
      --t-lift: calc(1.7s * var(--s));

      --ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
      --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
      --ease-in: cubic-bezier(0.55, 0.06, 0.68, 0.19);
      --ease-lift: cubic-bezier(0.87, 0, 0.13, 1);

      --intro-bg: {{ intro_bg | color_extract: 'red' }}, {{ intro_bg | color_extract: 'green' }}, {{ intro_bg | color_extract: 'blue' }};
      --intro-ink: {{ intro_ink | color_extract: 'red' }}, {{ intro_ink | color_extract: 'green' }}, {{ intro_ink | color_extract: 'blue' }};
      --intro-logo: min(64vw, {{ intro_logo_width }}px);

      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      cursor: pointer;
      color: rgb(var(--intro-ink));
      background: rgb(var(--intro-bg));
      clip-path: inset(0% 0% 0% 0%);
      -webkit-font-smoothing: antialiased;
      animation: dunas-intro-lift calc(0.7s * var(--s)) var(--ease-lift) var(--t-lift) forwards;
    }

    .dunas-skip-intro .dunas-intro {
      display: none;
    }

    .dunas-intro__stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2.4rem;
      animation: dunas-intro-stage-out calc(0.4s * var(--s)) var(--ease-in) var(--t-exit) forwards;
    }

    .dunas-intro__logo {
      width: var(--intro-logo);
      height: auto;
      overflow: visible;
    }

    /* Fine-line trace of each letter, then a smooth fill as the outline fades */
    .dunas-intro__letter {
      fill: rgb(var(--intro-ink));
      fill-opacity: 0;
      stroke: rgb(var(--intro-ink));
      stroke-width: 3;
      stroke-linejoin: round;
      stroke-linecap: round;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation:
        dunas-intro-draw calc(0.8s * var(--s)) var(--ease-in-out) calc(var(--t-draw) + var(--i) * 0.05s * var(--s)) forwards,
        dunas-intro-fill calc(0.35s * var(--s)) var(--ease-out) calc(var(--t-fill) + var(--i) * 0.03s * var(--s)) forwards;
    }

    .dunas-intro__letter--reg {
      stroke-width: 0;
      fill-opacity: 1;
      opacity: 0;
      animation: dunas-intro-fade-in calc(0.3s * var(--s)) var(--ease-out) calc(0.9s * var(--s)) forwards;
    }

    .dunas-intro__tagline {
      margin: 0;
      font-family: var(--font-heading-family, sans-serif);
      font-weight: 300;
      font-size: clamp(1.2rem, 3.4vw, 1.6rem);
      letter-spacing: 0.3em;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(0.6rem);
      animation: dunas-intro-rise calc(0.5s * var(--s)) var(--ease-out) var(--t-tagline) forwards;
    }

    @keyframes dunas-intro-draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes dunas-intro-fill {
      to {
        fill-opacity: 1;
        stroke-opacity: 0;
      }
    }

    @keyframes dunas-intro-fade-in {
      to {
        opacity: 1;
      }
    }

    @keyframes dunas-intro-rise {
      to {
        opacity: 0.8;
        transform: none;
      }
    }

    @keyframes dunas-intro-stage-out {
      to {
        opacity: 0;
        transform: translateY(-0.8rem);
      }
    }

    /* The panel lifts away to reveal the page */
    @keyframes dunas-intro-lift {
      to {
        clip-path: inset(0% 0% 100% 0%);
        visibility: hidden;
        pointer-events: none;
      }
    }

    /* Skipping: a short version of the exit, starting immediately */
    .dunas-intro.is-skipping {
      animation: dunas-intro-skip 0.55s var(--ease-lift) forwards;
    }

    .dunas-intro.is-skipping .dunas-intro__stage {
      animation: dunas-intro-stage-skip 0.3s var(--ease-in) forwards;
    }

    @keyframes dunas-intro-skip {
      to {
        clip-path: inset(0% 0% 100% 0%);
        visibility: hidden;
        pointer-events: none;
      }
    }

    @keyframes dunas-intro-stage-skip {
      to {
        opacity: 0;
        transform: translateY(-0.8rem);
      }
    }

    /* Visitors who prefer less motion: a still logo that fades out */
    @media (prefers-reduced-motion: reduce) {
      .dunas-intro__stage,
      .dunas-intro__letter,
      .dunas-intro__tagline {
        animation: none;
      }

      .dunas-intro__letter {
        fill-opacity: 1;
        stroke-opacity: 0;
        opacity: 1;
      }

      .dunas-intro__tagline {
        opacity: 0.8;
        transform: none;
      }

      .dunas-intro,
      .dunas-intro.is-skipping {
        animation: dunas-intro-fade 0.35s ease 0.6s forwards;
      }

      @keyframes dunas-intro-fade {
        to {
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
        }
      }
    }
  </style>

  <div id="DunasIntro" class="dunas-intro" data-mode="{{ intro_mode }}" aria-hidden="true">
    <div class="dunas-intro__stage">
      <svg class="dunas-intro__logo" viewBox="-10 -12 1370 318" xmlns="http://www.w3.org/2000/svg" focusable="false">
