{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "icon_1": "truck",
            "heading_1": "Free delivery over $50",
            "icon_2": "return",
            "heading_2": "Easy 30-day returns",
            "icon_3": "leaf",
            "heading_3": "Gentle, honest formulas"
          }
        },
        "how_to_use": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How to use",
            "icon": "none",
            "content": "<p>Apply a small amount to clean skin, morning and evening. Massage gently until absorbed. Follow with SPF during the day.</p>"
          }
        },
        "ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Ingredients",
            "icon": "none",
            "content": "<p>A short, honest list: desert botanicals, ceramides and gentle hydrators. The full INCI list is printed on the packaging.</p>"
          }
        },
        "delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery & returns",
            "icon": "none",
            "content": "<p>Free delivery on orders over $50. Not right for your skin? Return unopened items within 30 days.</p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "description",
        "how_to_use",
        "ingredients",
        "delivery"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12,
        "dunas_sticky_atc": true
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
