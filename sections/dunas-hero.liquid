{{ 'section-dunas-hero.css' | asset_url | stylesheet_tag }}
{%- assign button_style = section.settings.button_style | default: 'liquid' -%}

{%- liquid
  assign tagline_lines = section.settings.tagline | escape | newline_to_br | split: '<br />'
  assign body = section.settings.text | escape | newline_to_br
-%}

<section
  class="dunas-hero color-{{ section.settings.color_scheme }}"
  style="--dunas-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --dunas-hero-focus: {{ section.settings.image_focus }};"
>
  <div class="dunas-hero__media">
    {%- if section.settings.image != blank -%}
      {%- capture mobile_srcset -%}
        {%- if section.settings.image_mobile != blank -%}
          {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
          {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w
        {%- endif -%}
      {%- endcapture -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_srcset | strip }}" sizes="100vw">
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2600, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'dunas-hero__img'
        }}
      </picture>
    {%- else -%}
      <img
        src="{{ 'dunas-hero.jpg' | asset_url }}"
        alt=""
        width="1800"
        height="1200"
        class="dunas-hero__img"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="dunas-hero__inner">
    {%- if section.settings.tagline != blank -%}
      <h2 class="dunas-hero__tagline dunas-display">
        {%- for line in tagline_lines -%}
          {%- assign line_text = line | strip -%}
          {%- if line_text != blank -%}
            <span class="dunas-hero__line"><span style="--i: {{ forloop.index0 }};">{{ line_text }}</span></span>
          {%- endif -%}
        {%- endfor -%}
      </h2>
    {%- endif -%}

    <div class="dunas-hero__bottom">
      {%- if section.settings.text != blank -%}
        <p class="dunas-hero__text">{{ body }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="dunas-btn dunas-btn--{{ button_style }} dunas-hero__button"
          {% if button_style == 'liquid' %} data-liquid-glass data-glass-bend="{{ settings.dunas_button_glass_bend | default: 16 }}"{% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_logo -%}
      <div class="dunas-hero__logo" aria-hidden="true">
        {%- render 'dunas-logo', vertical: true -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.text_entrance -%}
    <script>
      (function () {
        // Text entrance: armed before the first paint, played once the intro has lifted.
        // Without the script, or with reduced motion, everything simply shows.
        var hero = document.currentScript.closest('.dunas-hero');
        if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        hero.classList.add('is-armed');
        var played = false;
        function play() {
          if (played) return;
          played = true;
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              hero.classList.add('is-in');
            });
          });
        }
        var root = document.documentElement;
        if (document.getElementById('DunasIntro') && !root.classList.contains('dunas-skip-intro') && !root.classList.contains('dunas-intro-done')) {
          window.addEventListener('dunas:intro-done', play, { once: true });
          setTimeout(play, 7000);
        } else {
          play();
        }
      })();
    </script>
  {%- endif -%}

</section>


{% schema %}
{
  "name": "DUNAS hero",
  "tag": "div",
  "class": "section-dunas-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the DUNAS campaign photo."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional portrait crop for phones."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image focus",
      "default": "50% 30%",
      "options": [
        {
          "value": "50% 0%",
          "label": "Top"
        },
        {
          "value": "50% 30%",
          "label": "Upper center"
        },
        {
          "value": "50% 50%",
          "label": "Center"
        },
        {
          "value": "50% 100%",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "label": "Image overlay",
      "default": 8
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Every Skin.\nEvery Day."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Your skin changes.\nYour care should\nstay close."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start my journey"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "liquid",
          "label": "Liquid glass"
        },
        {
          "value": "glass",
          "label": "Frosted glass"
        },
        {
          "value": "solid",
          "label": "Solid green"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "muted",
          "label": "Soft grey"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "liquid",
      "info": "Liquid glass bends the image behind it in Chrome, Edge and Android; other browsers show clear glass."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "text_entrance",
      "label": "Text entrance",
      "info": "After the intro, the tagline rises line by line, the logo draws upward and the text and button follow. The photo stays still.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show vertical DUNAS logo",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "DUNAS hero"
    }
  ]
}
{% endschema %}
