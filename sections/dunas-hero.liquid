{{ 'section-dunas-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tagline = section.settings.tagline | escape | newline_to_br
  assign body = section.settings.text | escape | newline_to_br
-%}

<section
  class="dunas-hero color-{{ section.settings.color_scheme }}"
  style="--dunas-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --dunas-hero-focus: {{ section.settings.image_focus }};"
>
  <div class="dunas-hero__media">
    {%- if section.settings.image != blank -%}
      {%- capture mobile_srcset -%}
        {%- if section.settings.image_mobile != blank -%}
          {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
          {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w
        {%- endif -%}
      {%- endcapture -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_srcset | strip }}" sizes="100vw">
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2600, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'dunas-hero__img'
        }}
      </picture>
    {%- else -%}
      <img
        src="{{ 'dunas-hero.jpg' | asset_url }}"
        alt=""
        width="1800"
        height="1200"
        class="dunas-hero__img"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="dunas-hero__inner">
    {%- if section.settings.tagline != blank -%}
      <h2 class="dunas-hero__tagline dunas-display">{{ tagline }}</h2>
    {%- endif -%}

    <div class="dunas-hero__bottom">
      {%- if section.settings.text != blank -%}
        <p class="dunas-hero__text">{{ body }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="dunas-btn dunas-btn--glass dunas-hero__button"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_logo -%}
      <div class="dunas-hero__logo" aria-hidden="true">
        {%- render 'dunas-logo', vertical: true -%}
      </div>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "DUNAS hero",
  "tag": "div",
  "class": "section-dunas-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the DUNAS campaign photo."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional portrait crop for phones."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image focus",
      "default": "50% 30%",
      "options": [
        { "value": "50% 0%", "label": "Top" },
        { "value": "50% 30%", "label": "Upper center" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "50% 100%", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "label": "Image overlay",
      "default": 8
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Every Skin.\nEvery Day."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Your skin changes.\nYour care should\nstay close."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start my journey"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show vertical DUNAS logo",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "DUNAS hero"
    }
  ]
}
{% endschema %}
