{{ 'section-dunas-story.css' | asset_url | stylesheet_tag }}
{%- if section.settings.entrance -%}
  <script src="{{ 'dunas-story.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- comment -%}
  DUNAS story, two layouts (setting "Layout"):
    spread    - the words centred like a magazine opener, then the two photos side by side
                (phones too), the second set a little lower.
    triptych  - photo, words, photo: stacked on phones, side by side on computers.
  "Open as the page scrolls" (default): tied to the scroll, the photos open from a smaller
  window inside their frames and the words slide into place (CSS only). Nothing grows past its
  frame. "Entrance animation" is the once-only alternative. Still for reduced motion.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading = s.heading | escape | replace: '®', '<sup>®</sup>' | newline_to_br | split: '<br />'
-%}

<section
  class="dunas-story dunas-story--{{ s.layout | default: 'swiss' }}{% if s.layout == 'swiss' or s.layout == blank %} dunas-story--spread{% endif %} color-{{ s.color_scheme }} gradient{% if s.scroll_motion %} dunas-story--motion{% endif %}{% if s.entrance %} dunas-story--entrance{% endif %}"
  style="--story-pt: {{ s.padding_top }}px; --story-pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width dunas-story__grid">
    <figure class="dunas-story__photo dunas-story__photo--one" data-story-reveal>
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '450, 650, 900, 1200, 1400',
            sizes: '(min-width: 990px) 40vw, 50vw',
            loading: 'lazy',
            class: 'dunas-story__img',
            alt: s.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'dunas-story__img dunas-story__img--placeholder' }}
      {%- endif -%}
    </figure>

    <div class="dunas-story__copy" data-story-reveal>
      {%- if s.eyebrow != blank -%}
        <p class="dunas-story__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="dunas-story__heading dunas-display">
          {%- for line in heading -%}
            {%- assign line_text = line | strip -%}
            {%- if line_text != blank -%}
              <span class="dunas-story__line" style="--i: {{ forloop.index0 }};">{{ line_text }}</span>
              {%- unless forloop.last -%}{{ ' ' }}{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </h2>
      {%- endif -%}

      {%- if s.text != blank -%}
        <div class="dunas-story__text">{{ s.text }}</div>
      {%- endif -%}

      {%- if s.button_label != blank or s.button_label_2 != blank -%}
        <div class="dunas-story__actions">
          {%- if s.button_label != blank -%}
            {%- assign link_1 = s.button_link | default: routes.all_products_collection_url -%}
            <a href="{{ link_1 }}" class="dunas-btn dunas-btn--solid">{{ s.button_label | escape }}</a>
          {%- endif -%}
          {%- if s.button_label_2 != blank -%}
            {%- assign link_2 = s.button_link_2 | default: routes.all_products_collection_url -%}
            <a href="{{ link_2 }}" class="dunas-btn dunas-btn--outline">{{ s.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <figure class="dunas-story__photo dunas-story__photo--two" data-story-reveal>
      {%- if s.image_2 != blank -%}
        {{
          s.image_2
          | image_url: width: 1400
          | image_tag:
            widths: '450, 650, 900, 1200, 1400',
            sizes: '(min-width: 990px) 40vw, 50vw',
            loading: 'lazy',
            class: 'dunas-story__img',
            alt: s.image_2.alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'dunas-story__img dunas-story__img--placeholder' }}
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "DUNAS story",
  "tag": "div",
  "class": "section section-dunas-story",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "swiss", "label": "Full-width heading, story left, photos right" },
        { "value": "spread", "label": "Words, then the two photos" },
        { "value": "triptych", "label": "Photo, words, photo" }
      ],
      "default": "swiss"
    },
    { "type": "image_picker", "id": "image", "label": "First photo" },
    { "type": "image_picker", "id": "image_2", "label": "Second photo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "EverySkin.\nEveryDay®",
      "info": "Each line on its own. ® is set small."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>DUNAS stands for calm, resilient and dependable skincare, shaped by the camel’s enduring character as a provider and trusted companion in UAE culture.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Find your routine" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button (optional)" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "header", "content": "Motion and layout" },
    {
      "type": "checkbox",
      "id": "entrance",
      "label": "Entrance animation",
      "info": "Plays once as the section comes into view, instead of following the scroll. Turn off \"Photos move with the scroll\" when using it.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "scroll_motion",
      "label": "Open as the page scrolls",
      "info": "The photos open from a smaller window and the words slide into place, following the scroll. Chrome, Edge and Safari; still elsewhere and for reduced motion.",
      "default": true
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "DUNAS story" }]
}
{% endschema %}
