{{ 'section-dunas-story.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  DUNAS story: photo, words, photo.
  Phones: the first photo, the heading, story and buttons centred, then the second photo.
  Computers: the same order left to right, the words centred between two tall photos.
  On scroll (CSS only) each photo opens from a soft frame and settles its zoom; on computers the
  two drift a little in opposite directions. Still for reduced motion.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading = s.heading | escape | replace: '®', '<sup>®</sup>' | newline_to_br | split: '<br />'
-%}

<section
  class="dunas-story color-{{ s.color_scheme }} gradient{% if s.scroll_motion %} dunas-story--motion{% endif %}"
  style="--story-pt: {{ s.padding_top }}px; --story-pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width dunas-story__grid">
    <figure class="dunas-story__photo dunas-story__photo--one">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '450, 650, 900, 1200, 1400',
            sizes: '(min-width: 990px) 30vw, 92vw',
            loading: 'lazy',
            class: 'dunas-story__img',
            alt: s.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'dunas-story__img dunas-story__img--placeholder' }}
      {%- endif -%}
    </figure>

    <div class="dunas-story__copy">
      {%- if s.eyebrow != blank -%}
        <p class="dunas-story__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="dunas-story__heading dunas-display">
          {%- for line in heading -%}
            {%- assign line_text = line | strip -%}
            {%- if line_text != blank -%}
              <span class="dunas-story__line">{{ line_text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </h2>
      {%- endif -%}

      {%- if s.text != blank -%}
        <div class="dunas-story__text">{{ s.text }}</div>
      {%- endif -%}

      {%- if s.button_label != blank or s.button_label_2 != blank -%}
        <div class="dunas-story__actions">
          {%- if s.button_label != blank -%}
            {%- assign link_1 = s.button_link | default: routes.all_products_collection_url -%}
            <a href="{{ link_1 }}" class="dunas-btn dunas-btn--solid">{{ s.button_label | escape }}</a>
          {%- endif -%}
          {%- if s.button_label_2 != blank -%}
            {%- assign link_2 = s.button_link_2 | default: routes.all_products_collection_url -%}
            <a href="{{ link_2 }}" class="dunas-btn dunas-btn--outline">{{ s.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <figure class="dunas-story__photo dunas-story__photo--two">
      {%- if s.image_2 != blank -%}
        {{
          s.image_2
          | image_url: width: 1400
          | image_tag:
            widths: '450, 650, 900, 1200, 1400',
            sizes: '(min-width: 990px) 30vw, 92vw',
            loading: 'lazy',
            class: 'dunas-story__img',
            alt: s.image_2.alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'dunas-story__img dunas-story__img--placeholder' }}
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "DUNAS story",
  "tag": "div",
  "class": "section section-dunas-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "First photo", "info": "Above the words on phones, left of them on computers." },
    { "type": "image_picker", "id": "image_2", "label": "Second photo", "info": "Below the words on phones, right of them on computers." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "EverySkin.\nEveryDay®",
      "info": "Each line on its own; every second line takes the brand accent. ® is set small."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>DUNAS stands for calm, resilient and dependable skincare, shaped by the camel’s enduring character as a provider and trusted companion in UAE culture.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Find your routine" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button (optional)" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "header", "content": "Motion and layout" },
    {
      "type": "checkbox",
      "id": "scroll_motion",
      "label": "Photos move with the scroll",
      "info": "Each photo opens from a soft frame and settles; on computers they drift apart a little. Chrome, Edge and Safari; still elsewhere and for reduced motion.",
      "default": true
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "DUNAS story" }]
}
{% endschema %}
